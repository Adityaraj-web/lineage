# RPC endpoint (optional). Default https://test.rpc.fastnear.com, with fastnear/drpc failover.
NEAR_RPC_URL=
# Root testnet account for `npm run deploy` (required, no default).
LINEAGE_ROOT=
# Root private key (optional). Default: ~/.near-credentials/testnet/<root>.json
LINEAGE_ROOT_KEY=
# Agent function-call keys. Written to .env.local by `npm run deploy`. Never commit.
AGENT_L_KEY=
AGENT_G_KEY=
